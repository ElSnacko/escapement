# Copy to .env (gitignored) and fill in. Real environment variables override these.

# HuggingFace -- used by scripts/upload_runs.py (durable, PRIVATE data snapshots).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_USERNAME=your-hf-user
HF_DATASET=escapement-runs

# Per-session model endpoint (the Kaggle llama-server over a Cloudflare tunnel).
# These rotate every session -- set them here per run, or pass --host / --api-key.
ESCAPE_HOST=https://<random>.trycloudflare.com
ESCAPE_API_KEY=esc-xxxxxxxxxxxxxxxxxxxxxxxx
